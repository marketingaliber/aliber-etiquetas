{
  "name": "aliber-etiquetas",
  "productName": "Aliber Etiquetas",
  "version": "1.1.0",
  "description": "Etiquetas de gôndola da Aliber Informática / Sistemas",
  "author": "Aliber Informática / Sistemas",
  "private": true,
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "teste": "node testes/rodar.js",
    "instalador": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.aliber.etiquetas",
    "productName": "Aliber Etiquetas",
    "directories": {
      "output": "instalador"
    },
    "files": [
      "app/**",
      "core/**",
      "panel/**",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "AliberEtiquetas"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Aliber Etiquetas",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "AliberEtiquetas-Instalador.exe",
      "uninstallDisplayName": "Aliber Etiquetas",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "marketingaliber",
        "repo": "aliber-etiquetas",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marketingaliber/aliber-etiquetas.git"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
